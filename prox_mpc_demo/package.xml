<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>prox_mpc_demo</name>
  <version>1.0.0</version>
  <description>Self-contained closed-loop simulation and benchmark for the ProxMPC
  core: drives a bundled kinematic model (bike / r2d2) toward a goal with no
  external simulator, publishes the command and predicted path, and logs the
  solve time.</description>
  <maintainer email="simone.contorno@outlook.it">Simone Contorno</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>Eigen3</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>prox_mpc_core</depend>
  <depend>prox_mpc_msgs</depend>
  <depend version_gte="0.6.5">proxsuite</depend>
  <depend>rclcpp</depend>
  <depend>tf2_ros</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <!-- Nav2 + Gazebo Harmonic bringup (nav2_simulation.launch.py). The controller
       plugin, the obstacle tracker, and the canonical tb3 + ros_gz scenario it wraps. -->
  <exec_depend>prox_mpc_controller</exec_depend>
  <exec_depend>prox_mpc_obstacle_tracker</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_minimal_tb3_sim</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
