<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>prox_mpc_test_models</name>
  <version>2.0.0</version>
  <description>Test-fixture prox_mpc::Model plugins for the ProxMPC stack. These
  models exercise controller paths the bundled production models cannot reach
  (for example a non-finite command, or an asymmetric bound). Not for
  production use. Fixture class names are not a stable interface and may
  change without notice.</description>
  <maintainer email="simone.contorno@outlook.it">Simone Contorno</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/simone-contorno/prox_mpc</url>
  <url type="bugtracker">https://github.com/simone-contorno/prox_mpc/issues</url>
  <author email="simone.contorno@outlook.it">Simone Contorno</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>pluginlib</depend>
  <depend>prox_mpc_core</depend>
  <depend version_gte="0.6.5">proxsuite</depend>
  <depend>rclcpp</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
