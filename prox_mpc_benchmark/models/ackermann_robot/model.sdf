<?xml version="1.0"?>
<!--
  Minimal Ackermann (car-like) robot for the benchmark's mode (a) Bicycle wiring.
  A controller's body Twist on cmd_vel is converted to steering by
  the gz-sim AckermannSteering system (the "ros_gz Ackermann steering bridge"):
  it consumes linear.x (speed) + angular.z (yaw rate), applies the bicycle
  geometry (wheelbase L = 1.0 m, must match robots/ackermann.yaml model_params.L),
  drives the rear wheels, steers the front wheels, and publishes odometry + TF.

  A 2D lidar feeds AMCL / the Nav2 costmaps. Spawn with ros_gz_sim `create`, then
  bridge /cmd_vel (Twist) and /scan (LaserScan); ground truth is taken from the
  pose-publisher.
-->
<sdf version="1.9">
  <model name="ackermann_robot">
    <pose>0 0 0.18 0 0 0</pose>

    <link name="base_link">
      <inertial>
        <mass>20.0</mass>
        <inertia><ixx>1.0</ixx><iyy>1.5</iyy><izz>2.0</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="chassis_col">
        <geometry><box><size>1.4 0.6 0.3</size></box></geometry>
      </collision>
      <visual name="chassis_vis">
        <geometry><box><size>1.4 0.6 0.3</size></box></geometry>
        <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.4 0.8 1</diffuse></material>
      </visual>
      <sensor name="lidar" type="gpu_lidar">
        <pose>0.5 0 0.25 0 0 0</pose>
        <topic>scan</topic>
        <update_rate>10</update_rate>
        <lidar>
          <scan><horizontal><samples>360</samples><resolution>1</resolution>
            <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
          <range><min>0.12</min><max>12.0</max><resolution>0.01</resolution></range>
        </lidar>
        <always_on>1</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>

    <!-- Rear wheels (driven). -->
    <link name="rear_left_wheel">
      <pose>-0.5 0.35 -0.08 -1.5708 0 0</pose>
      <inertial><mass>1.0</mass>
        <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><cylinder><radius>0.18</radius><length>0.1</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.18</radius><length>0.1</length></cylinder></geometry></visual>
    </link>
    <link name="rear_right_wheel">
      <pose>-0.5 -0.35 -0.08 -1.5708 0 0</pose>
      <inertial><mass>1.0</mass>
        <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><cylinder><radius>0.18</radius><length>0.1</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.18</radius><length>0.1</length></cylinder></geometry></visual>
    </link>

    <!-- Front steering wheels. -->
    <link name="front_left_wheel">
      <pose>0.5 0.35 -0.08 -1.5708 0 0</pose>
      <inertial><mass>1.0</mass>
        <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><cylinder><radius>0.18</radius><length>0.1</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.18</radius><length>0.1</length></cylinder></geometry></visual>
    </link>
    <link name="front_right_wheel">
      <pose>0.5 -0.35 -0.08 -1.5708 0 0</pose>
      <inertial><mass>1.0</mass>
        <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><cylinder><radius>0.18</radius><length>0.1</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.18</radius><length>0.1</length></cylinder></geometry></visual>
    </link>

    <!-- Steering link stubs. -->
    <link name="front_left_steer"><pose>0.5 0.35 -0.08 0 0 0</pose>
      <inertial><mass>0.1</mass>
        <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial></link>
    <link name="front_right_steer"><pose>0.5 -0.35 -0.08 0 0 0</pose>
      <inertial><mass>0.1</mass>
        <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial></link>

    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_left_wheel</child>
      <axis><xyz>0 0 1</xyz></axis></joint>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_right_wheel</child>
      <axis><xyz>0 0 1</xyz></axis></joint>

    <joint name="front_left_steer_joint" type="revolute">
      <parent>base_link</parent><child>front_left_steer</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-0.6</lower><upper>0.6</upper></limit></axis></joint>
    <joint name="front_right_steer_joint" type="revolute">
      <parent>base_link</parent><child>front_right_steer</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-0.6</lower><upper>0.6</upper></limit></axis></joint>
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>front_left_steer</parent><child>front_left_wheel</child>
      <axis><xyz>0 0 1</xyz></axis></joint>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>front_right_steer</parent><child>front_right_wheel</child>
      <axis><xyz>0 0 1</xyz></axis></joint>

    <!-- Twist -> Ackermann steering (the bridge). Geometry mirrors model_params.L. -->
    <plugin filename="gz-sim-ackermann-steering-system"
            name="gz::sim::systems::AckermannSteering">
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steer_joint</left_steering_joint>
      <right_steering_joint>front_right_steer_joint</right_steering_joint>
      <kingpin_width>0.7</kingpin_width>
      <steering_limit>0.6</steering_limit>
      <wheel_base>1.0</wheel_base>
      <wheel_separation>0.7</wheel_separation>
      <wheel_radius>0.18</wheel_radius>
      <min_velocity>-1.0</min_velocity>
      <max_velocity>1.0</max_velocity>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

    <!-- Ground-truth pose for the accuracy reference. -->
    <plugin filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_model_pose>true</publish_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>30</update_frequency>
    </plugin>
  </model>
</sdf>
