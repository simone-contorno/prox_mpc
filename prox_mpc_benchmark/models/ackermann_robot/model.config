<?xml version="1.0"?>
<model>
  <name>ackermann_robot</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Simone Contorno</name>
    <email>simone.contorno@outlook.it</email>
  </author>
  <description>
    Minimal Ackermann (car-like) robot for the ProxMPC benchmark mode (a) Bicycle
    wiring: gz AckermannSteering converts a body Twist to steering; a 2D lidar
    feeds Nav2; a pose-publisher provides the ground-truth accuracy reference.
  </description>
</model>
