<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>prox_mpc_core</name>
  <version>2.0.0</version>
  <description>ProxMPC core: a nonlinear Model Predictive Control solved by a
  Sequential Quadratic Programming scheme that recursively calls the ProxQP
  solver, with Eigen for linear algebra. Library only; no ROS node.</description>
  <maintainer email="simone.contorno@outlook.it">Simone Contorno</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/simone-contorno/prox_mpc</url>
  <url type="bugtracker">https://github.com/simone-contorno/prox_mpc/issues</url>
  <author email="simone.contorno@outlook.it">Simone Contorno</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>pluginlib</depend>
  <!-- Canonical reproducible provisioning is the apt key ros-jazzy-proxsuite. -->
  <depend version_gte="0.6.5">proxsuite</depend>
  <depend>rclcpp</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
